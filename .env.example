# Copy to .env.local for local development. On Vercel, set these in
# Project → Settings → Environment Variables instead. Never commit real values.

# Neon connection string (Neon dashboard → Connect → "Pooled connection")
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Claude API key (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Long random string. The iOS Shortcut sends it in the x-links-secret header.
LINKS_SECRET=change-me

# Password for the web UI (used from Phase 2)
APP_PASSWORD=change-me
